def is_binary_path(path):
    """Check if path has a known binary extension."""
    dot = path.rfind(".")
    return dot >= 0 and path[dot:].lower() in BINARY_EXTENSIONS


def extract_diff_path(header):
    """Extract file path from 'diff --git a/X b/Y' header."""
    if " b/" in header:
        return header.split(" b/", 1)[1]
    return ""


_LOCKFILE_SUFFIXES = tuple(p[1:] for p in EXCLUDED_PATTERNS if p.startswith("*"))
_LOCKFILE_NAMES = frozenset(p for p in EXCLUDED_PATTERNS if not p.startswith("*"))


def is_lockfile(path):
    """Check if a file path matches any lockfile pattern."""
    basename = path.rsplit("/", 1)[-1]
    if basename in _LOCKFILE_NAMES:
        return True
    return path.endswith(_LOCKFILE_SUFFIXES)


_GIT_ESCAPE_MAP = {
    '\\': ord('\\'), '"': ord('"'), 'n': ord('\n'), 't': ord('\t'),
    'a': ord('\a'), 'b': ord('\b'), 'f': ord('\f'), 'v': ord('\v'),
    'r': ord('\r'),
}


def git_unquote(path):
    """Decode git's C-style quoted path."""
    if not (path.startswith('"') and path.endswith('"')):
        return path
    inner = path[1:-1]
    result = bytearray()
    i = 0
    while i < len(inner):
        if inner[i] == '\\' and i + 1 < len(inner):
            c = inner[i + 1]
            if c in '01234567' and i + 3 < len(inner):
                result.append(int(inner[i + 1:i + 4], 8))
                i += 4
            elif c in _GIT_ESCAPE_MAP:
                result.append(_GIT_ESCAPE_MAP[c])
                i += 2
            else:
                result.extend(inner[i].encode('utf-8'))
                i += 1
        else:
            result.extend(inner[i].encode('utf-8'))
            i += 1
    return result.decode('utf-8')


def get_staged_files_for_commit():
    """Get actual staged files that can be committed (excluding lockfiles).

    Only includes files in the current working directory and below.
    Returns dict mapping path -> {old_path, is_deleted}
    """
    name_status, _, _ = run(["git", "diff", "--cached", "--name-status", "-M", "--", "."])
    files = {}
    for line in name_status.strip().splitlines():
        if not line:
            continue
        parts = line.split("\t")
        if len(parts) < 2:
            continue
        status = parts[0]
        if status.startswith("R") and len(parts) >= 3:  # Rename: R100\told\tnew
            old_path = git_unquote(parts[1])
            new_path = git_unquote(parts[2])
            if not is_lockfile(new_path):
                files[new_path] = {"old": old_path, "deleted": False}
        elif status == "D":  # Deleted
            path = git_unquote(parts[1])
            if not is_lockfile(path):
                files[path] = {"old": path, "deleted": True}
        else:  # Added, Modified, etc
            path = git_unquote(parts[1])
            if not is_lockfile(path):
                files[path] = {"old": path, "deleted": False}
    return files


def normalize_llm_files(llm_files, staged_files):
    """Map LLM file paths to actual staged paths."""
    if not isinstance(llm_files, list):
        return []
    old_to_new = {info["old"]: path for path, info in staged_files.items()}
    normalized = set()
    dropped = []
    for f in llm_files:
        if not isinstance(f, str):
            continue
        f = f.lstrip("/")
        if f.startswith("a/") or f.startswith("b/"):
            f = f[2:]
        if f in staged_files:
            normalized.add(f)
        elif f in old_to_new:
            normalized.add(old_to_new[f])
        else:
            dropped.append(f)
    if dropped:
        log("INFO", "LLM referenced unknown files", {"dropped": dropped})
    return list(normalized)


def is_file_deleted(path, staged_files):
    """Check if a file is marked as deleted in staged files."""
    info = staged_files.get(path)
    return info.get("deleted", False) if info else False


def is_echoing_keys(commit):
    """Check if commit has literal key strings instead of real values."""
    if not isinstance(commit, dict):
        return True
    files = commit.get("files")
    message = commit.get("message")
    description = commit.get("description")

    if files is None:
        return True
    if isinstance(files, str) and files in ("files", "[]", "", "file"):
        return True
    if isinstance(files, list) and len(files) == 0:
        return True

    if message is None:
        return True
    if isinstance(message, str) and message.lower() in ("message", "", "commit message", "msg"):
        return True

    if isinstance(description, str) and description.lower() == "description":
        return True

    return False


_VALID_TYPES = {"feat", "fix", "refactor", "chore", "docs", "style", "test", "perf"}


def _clean_commit_message(message):
    """Clean up LLM-generated commit message for quality."""
    message = message.strip().rstrip(".")
    # Truncate to 72 chars (git convention for subject line)
    if len(message) > 72:
        message = message[:69] + "..."
    return message


_SCOPE_RE = re.compile(r'^(\w+)(?:\(([^)]*)\))?:\s*(.*)')


def _ensure_grounded_scope(commit):
    """If the LLM produced a message with no scope, derive one from file paths."""
    msg = commit.get("message", "")
    m = _SCOPE_RE.match(msg)
    if not m:
        return commit
    type_, scope, subject = m.groups()
    if scope:
        return commit
    files = commit.get("files", [])
    if not files:
        return commit
    scopes = set()
    for f in files:
        s = _dir_scope(f)
        if s:
            scopes.add(s)
    if len(scopes) == 1:
        scope = scopes.pop()
        commit["message"] = f"{type_}({scope}): {subject}"
    return commit


def validate_and_fix_commits(commits, staged_files):
    """Validate LLM output and fix issues.

    Returns (fixed_commits, missing_files_set).
    missing_files_set is empty when all staged files are covered.
    """
    # Detect key-echoing pattern (model failure)
    echo_count = sum(1 for c in commits if is_echoing_keys(c))
    if echo_count > 0 and echo_count == len(commits):
        exit_with_error(
            f"LLM returned malformed commits (echoing keys: {echo_count}/{len(commits)})",
            {"commits_sample": commits[:3]}
        )

    all_staged = set(staged_files.keys())
    covered_files = set()
    fixed_commits = []

    for commit in commits:
        if not isinstance(commit, dict):
            warn(f"skipping non-dict commit: {commit}")
            continue
        if "files" not in commit or "message" not in commit:
            warn(f"skipping malformed commit: {commit}")
            continue

        normalized = normalize_llm_files(commit["files"], staged_files)
        if not normalized:
            warn(f"skipping commit with no valid files: {commit.get('message', '<missing>')}")
            continue

        covered_files.update(normalized)
        fixed = {
            "files": normalized,
            "message": _clean_commit_message(commit["message"]),
            "description": commit.get("description", ""),
        }
        fixed_commits.append(_ensure_grounded_scope(fixed))

    if not fixed_commits:
        # No valid commits at all - create a fallback single commit
        warn("LLM failed to group files, creating single commit")
        return [{
            "files": list(all_staged),
            "message": "chore: update files",
            "description": "",
        }], set()

    missing_files = all_staged - covered_files
    return fixed_commits, missing_files


def get_diff_for_files(files):
    """Get the diff for specific files only (fresh from git).

    Kept for callers that don't have a parsed diff cache to hand. The
    hot path in phase 2 uses ``slice_diff_by_file`` against an in-memory
    cache built via ``parse_diff_by_file``.
    """
    diff, _, _ = run(["git", "diff", "--cached", "--minimal", "--"] + [_top(f) for f in files])
    return strip_diff_noise(diff)


def parse_diff_by_file(diff):
    """Split a unified diff into a dict of {file_path: section_text}.

    Each section includes its ``diff --git`` header so downstream code can
    treat it as a self-contained mini-diff.
    """
    sections = {}
    current_path = None
    current_lines = []
    for line in diff.splitlines():
        if line.startswith("diff --git"):
            if current_path is not None:
                sections[current_path] = "\n".join(current_lines)
            current_path = extract_diff_path(line)
            current_lines = [line]
        elif current_path is not None:
            current_lines.append(line)
    if current_path is not None:
        sections[current_path] = "\n".join(current_lines)
    return sections


def slice_diff_by_file(diff_by_file, files):
    """Return a concatenated diff for ``files`` from the parsed cache."""
    return "\n".join(diff_by_file[f] for f in files if f in diff_by_file)


def compress_diff(diff, max_chars=None):
    """Compress diff while preserving semantic information.

    Respects a total character budget, skips binary files, and enforces
    per-file limits so the result fits within LLM context windows.
    """
    if max_chars is None:
        max_chars = MAX_COMPRESSED_CHARS

    excludes = build_pathspec_excludes()
    stat, _, _ = run(["git", "diff", "--cached", "--stat", "--", "."] + excludes)

    parts = [f"DIFF STAT:\n{stat}"]

    header_chars = sum(len(p) for p in parts) + 50
    remaining = max_chars - header_chars
    if remaining <= 0:
        return "\n".join(parts)

    # Parse diff into per-file sections
    file_sections = []
    current_header = None
    current_lines = []
    for line in diff.splitlines():
        if line.startswith("diff --git"):
            if current_header:
                file_sections.append((current_header, current_lines))
            current_header = line
            current_lines = []
        elif current_header:
            current_lines.append(line)
    if current_header:
        file_sections.append((current_header, current_lines))

    if not file_sections:
        return "\n".join(parts)

    parts.append("COMPRESSED PATCHES:")
    total_chars = 0
    files_truncated = 0

    n_files = len(file_sections)
    for file_idx, (file_header, lines) in enumerate(file_sections):
        if total_chars >= remaining:
            files_truncated += 1
            continue

        path = extract_diff_path(file_header)

        # Skip binary files
        is_binary = any("Binary files" in l for l in lines[:5])
        if is_binary or is_binary_path(path):
            summary = f"{file_header}\n[binary file]"
            parts.append(summary)
            total_chars += len(summary)
            continue

        files_left = n_files - file_idx
        per_file_budget = (remaining - total_chars) // max(files_left, 1)

        file_parts = [file_header]
        file_chars = len(file_header)
        hunk_count = 0
        hunk_lines = 0
        hunk_truncated = False

        for line in lines:
            if file_chars >= per_file_budget:
                file_parts.append("[... file truncated]")
                break

            if line.startswith("@@") and " @@" in line:
                hunk_count += 1
                hunk_lines = 0
                hunk_truncated = False
                if hunk_count <= MAX_HUNKS_PER_FILE:
                    file_parts.append(line)
                    file_chars += len(line)
            elif hunk_count <= MAX_HUNKS_PER_FILE:
                if line.startswith("---") or line.startswith("+++"):
                    file_parts.append(line)
                    file_chars += len(line)
                elif line.startswith("rename ") or line.startswith("new file") or line.startswith("deleted file"):
                    file_parts.append(line)
                    file_chars += len(line)
                elif hunk_lines < MAX_LINES_PER_HUNK:
                    if line.startswith("+") or line.startswith("-"):
                        file_parts.append(line)
                        file_chars += len(line)
                        hunk_lines += 1
                    elif line.startswith(" ") and hunk_lines < MAX_LINES_PER_HUNK // 2:
                        file_parts.append(line)
                        file_chars += len(line)
                        hunk_lines += 1
                elif not hunk_truncated:
                    file_parts.append("[... hunk truncated]")
                    hunk_truncated = True

        if hunk_count > MAX_HUNKS_PER_FILE:
            file_parts.append(f"[... {hunk_count - MAX_HUNKS_PER_FILE} more hunks truncated]")

        parts.extend(file_parts)
        total_chars += file_chars

    if files_truncated > 0:
        parts.append(f"[... {files_truncated} more files truncated]")

    return "\n".join(parts)


def prepare_diff_for_llm(config, diff, max_chars=None):
    """Shrink a diff down to what a model needs to read."""
    if config["PROVIDER"] == PROVIDER_CLAUDE:
        diff = strip_diff_context(diff)
    if len(diff) <= MAX_DIFF_CHARS:
        return diff
    return compress_diff(diff, max_chars=max_chars)


RETRYABLE_STATUS_CODES = {429, 500, 502, 503, 504}
MAX_RETRIES = 3


class ContextLengthExceeded(Exception):
    """Raised when LLM context length is exceeded."""


def try_repair_json(content):
    """Attempt to repair truncated or malformed JSON arrays/objects."""
    content = content.strip()

    # Strip leading garbage - find first [ or {
    start_idx = -1
    for i, c in enumerate(content):
        if c in '[{':
            start_idx = i
            break
    if start_idx > 0:
        content = content[start_idx:]

    # Strip trailing garbage - find last ] or }
    end_idx = -1
    for i in range(len(content) - 1, -1, -1):
        if content[i] in ']}':
            end_idx = i
            break
    if end_idx >= 0 and end_idx < len(content) - 1:
        content = content[:end_idx + 1]

    try:
        return json.loads(content)
    except json.JSONDecodeError:
        pass

    repairs = [
        '"}]',
        '"]}}]',
        '"}]}]',
        '"]',
        '"}',
        '}]',
        ']',
        '}',
        '"]}',
        '"],"hint":""}]',
    ]

    for repair in repairs:
        try:
            result = json.loads(content + repair)
            warn(f"repaired truncated JSON (appended: {repair})")
            return result
        except json.JSONDecodeError:
            continue

    for end_char in ['},', '],', '}', ']', '",']:
        idx = content.rfind(end_char)
        if idx > 0:
            truncated = content[:idx + len(end_char)]
            for close in [']', ']}', '}]', ']}]', '"]}', '"],"hint":""}]']:
                try:
                    result = json.loads(truncated + close)
                    warn("repaired truncated JSON by removing incomplete element")
                    return result
                except json.JSONDecodeError:
                    continue

    return None


class _LLMTransportError(Exception):
    """A provider failure worth retrying."""


LLM_WALL_CLOCK_TIMEOUT_S = 90


def _call_openrouter(config, system_prompt, user_content, start):
    """POST to OpenRouter and read the SSE stream.

    Returns (content, finish_reason, ttfb).
    """
    import requests

    use_structured = config.get("STRUCTURED_OUTPUT", "true").lower() == "true"
    request_body = {
        "model": config["MODEL"],
        "messages": [
            {"role": "system", "content": system_prompt},
            {"role": "user", "content": user_content},
        ],
        "temperature": 0,
        "max_tokens": MAX_OUTPUT_TOKENS,
        "stream": True,
    }
    if use_structured:
        request_body["response_format"] = {"type": "json_object"}

    resp = None
    try:
        try:
            resp = requests.post(
                "https://openrouter.ai/api/v1/chat/completions",
                headers={
                    "Authorization": f"Bearer {config['OPENROUTER_API_KEY']}",
                    "Content-Type": "application/json",
                    "Accept": "text/event-stream",
                },
                json=request_body,
                timeout=(10, LLM_WALL_CLOCK_TIMEOUT_S),
                stream=True,
            )
        except requests.exceptions.RequestException as e:
            raise _LLMTransportError(str(e)) from e

        if resp.status_code != 200:
            text = resp.text
            if resp.status_code == 400 and "context length" in text.lower():
                log("INFO", "LLM context length exceeded", {"response": text[:300]})
                raise ContextLengthExceeded(text[:500])
            if resp.status_code in RETRYABLE_STATUS_CODES:
                raise _LLMTransportError(f"API returned {resp.status_code}")
            exit_with_error(
                f"LLM API returned {resp.status_code}",
                {"status_code": resp.status_code, "response": text[:500], "model": config["MODEL"]}
            )

        ttfb = None
        finish_reason = ""
        parts = []
        try:
            for raw_line in resp.iter_lines(decode_unicode=True):
                if not raw_line or raw_line.startswith(":"):
                    continue
                if not raw_line.startswith("data:"):
                    continue
                data = raw_line[5:].lstrip()
                if data == "[DONE]":
                    break
                if ttfb is None:
                    ttfb = time.monotonic() - start
                try:
                    chunk = json.loads(data)
                except json.JSONDecodeError:
                    continue
                choices = chunk.get("choices") or []
                if not choices:
                    continue
                delta = choices[0].get("delta") or {}
                piece = delta.get("content")
                if piece:
                    parts.append(piece)
                fr = choices[0].get("finish_reason")
                if fr:
                    finish_reason = fr
                if time.monotonic() - start > LLM_WALL_CLOCK_TIMEOUT_S:
                    raise _LLMTransportError(f"no response within {LLM_WALL_CLOCK_TIMEOUT_S}s")
        except requests.exceptions.RequestException as e:
            raise _LLMTransportError(str(e)) from e
        return "".join(parts), finish_reason, ttfb
    finally:
        if resp is not None:
            resp.close()


# --safe-mode drops CLAUDE.md, skills, plugins, hooks and MCP servers, none of
# which this prompt wants, and leaves subscription auth working. --bare goes
# further but forces ANTHROPIC_API_KEY, which defeats the point of running
# through the CLI at all.
CLAUDE_CLI_ARGS = [
    "-p",
    "--safe-mode",
    "--strict-mcp-config",
    "--tools", "",
    "--no-session-persistence",
    "--output-format", "json",
]


def _call_claude_cli(config, system_prompt, user_content, start):
    """Run the Claude Code CLI non-interactively.

    Returns (content, finish_reason, ttfb).
    """
    cmd = ["claude", *CLAUDE_CLI_ARGS, "--model", config["MODEL"],
           "--system-prompt", system_prompt]
    try:
        result = subprocess.run(
            cmd,
            input=user_content.encode(),
            capture_output=True,
            timeout=LLM_WALL_CLOCK_TIMEOUT_S,
        )
    except subprocess.TimeoutExpired as e:
        raise _LLMTransportError(f"claude cli timed out after {LLM_WALL_CLOCK_TIMEOUT_S}s") from e
    except FileNotFoundError:
        exit_with_error(
            "claude cli not found on PATH",
            {"provider": PROVIDER_CLAUDE}
        )

    stdout = result.stdout.decode("utf-8", errors="replace")
    stderr = result.stderr.decode("utf-8", errors="replace")
    # The CLI reports its own failures as a JSON envelope on stdout, so parse
    # before deciding what went wrong. stderr is usually empty.
    try:
        envelope = json.loads(stdout)
    except json.JSONDecodeError:
        detail = (stderr or stdout).strip()[:300]
        raise _LLMTransportError(f"claude cli exited {result.returncode}: {detail}")

    if result.returncode != 0 or envelope.get("is_error"):
        detail = str(envelope.get("result") or stderr).strip()[:300]
        if "prompt is too long" in detail.lower():
            log("INFO", "LLM context length exceeded", {"detail": detail})
            raise ContextLengthExceeded(detail)
        status = envelope.get("api_error_status")
        if status and status not in RETRYABLE_STATUS_CODES:
            exit_with_error(
                f"claude cli failed: {detail}",
                {"api_error_status": status, "model": config["MODEL"]}
            )
        raise _LLMTransportError(detail or f"claude cli exited {result.returncode}")

    ttft_ms = envelope.get("ttft_ms")
    ttfb = ttft_ms / 1000 if ttft_ms else None
    # The rest of this module speaks OpenAI's name for truncation.
    finish_reason = "length" if envelope.get("stop_reason") == "max_tokens" else ""
    return envelope.get("result", ""), finish_reason, ttfb


PROVIDER_CALLERS = {
    PROVIDER_OPENROUTER: _call_openrouter,
    PROVIDER_CLAUDE: _call_claude_cli,
}


def call_llm_raw(config, system_prompt, user_content, task_label=None):
    """Make an LLM call and return parsed JSON.

    Records TTFB where the provider reports it and warns when a single
    request is unusually slow. ``task_label`` is used in warning messages
    and logs so it's obvious which group is slow.
    """
    call_provider = PROVIDER_CALLERS[config["PROVIDER"]]
    label = task_label or "llm"
    content = ""
    finish_reason = ""

    for attempt in range(MAX_RETRIES):
        start = time.monotonic()
        _timings.request_started()
        try:
            content, finish_reason, ttfb = call_provider(
                config, system_prompt, user_content, start
            )
            duration = time.monotonic() - start
            _timings.request_finished(duration)
            log("INFO", "llm done", {
                "task": label,
                "ttfb_ms": int((ttfb or duration) * 1000),
                "duration_ms": int(duration * 1000),
                "chars": len(content),
            })
            if duration >= SLOW_LLM_THRESHOLD_S:
                warn(f"slow LLM response: {label} took {duration:.1f}s")
            break
        except _LLMTransportError as e:
            _timings.request_finished(time.monotonic() - start)
            if attempt < MAX_RETRIES - 1:
                wait_time = 2 ** attempt
                warn(f"LLM request failed: {e}, retrying in {wait_time}s (attempt {attempt + 1}/{MAX_RETRIES})")
                time.sleep(wait_time)
                continue
            exit_with_error(
                f"LLM API request failed after {MAX_RETRIES} attempts: {e}",
                {"model": config["MODEL"], "attempts": MAX_RETRIES}
            )

    content = content.strip()
    if content.startswith("```"):
        content = "\n".join(content.split("\n")[1:])
    if content.endswith("```"):
        content = "\n".join(content.split("\n")[:-1])
    content = content.strip()

    if finish_reason == "length":
        warn("LLM response was truncated due to length limit")
    if not content:
        record_error("LLM returned empty response", {"model": config["MODEL"]})
        return []

    try:
        return json.loads(content)
    except json.JSONDecodeError:
        pass

    repaired = try_repair_json(content)
    if repaired is not None:
        return repaired

    record_error(
        "LLM returned unparseable JSON",
        {"content": content[:1000], "model": config["MODEL"]}
    )
    return []


def is_malformed_response(result):
    """Check if response is clearly malformed (key echoing or invalid structure)."""
    if not isinstance(result, list):
        return True
    if not result:
        return True
    echo_count = sum(1 for r in result if is_echoing_keys(r))
    return echo_count > len(result) // 2


def normalize_llm_result(result):
    """Normalize LLM result to a list of commits."""
    if isinstance(result, list):
        return result
    if isinstance(result, dict):
        if "commits" in result:
            return result["commits"]
        if "groups" in result:
            return result["groups"]
        if "files" in result and "message" in result:
            return [result]
    return []


def call_llm(config, diff, missing_hint=None, staged_files=None):
    """Single-phase: send diff and get commits.

    missing_hint: set of file paths the LLM missed on a previous attempt.
    staged_files: dict of staged file paths (used for path context).
    """
    prompts = PROMPTS[config["PROVIDER"]]
    content = prepare_diff_for_llm(config, diff)
    path_ctx = compute_path_context(staged_files.keys()) if staged_files else ""
    if path_ctx:
        content = path_ctx + "\n" + content
    if missing_hint:
        hint_line = "IMPORTANT: You previously missed these files — they MUST be included: " + ", ".join(sorted(missing_hint))
        content = hint_line + "\n\n" + content
    log("INFO", "sending diff to LLM", {"chars": len(content), "compressed": len(diff) > MAX_DIFF_CHARS})
    result = call_llm_raw(config, prompts["system"], content, task_label="single-shot")
    result = normalize_llm_result(result)

    if is_malformed_response(result):
        warn("response looks malformed, retrying with stronger prompt")
        retry_content = compress_diff(diff) if len(diff) > MAX_DIFF_CHARS // 2 else content
        result = call_llm_raw(config, prompts["retry"], retry_content, task_label="single-shot-retry")
        result = normalize_llm_result(result)

    return result


def detect_directory_moves(staged_files):
    """Detect directory-level rename/move operations."""
    transforms = defaultdict(list)

    for path, info in staged_files.items():
        old_path = info.get("old", path)
        if old_path == path or info.get("deleted"):
            continue

        old_parts = old_path.split("/")
        new_parts = path.split("/")

        common_suffix_len = 0
        for i in range(1, min(len(old_parts), len(new_parts)) + 1):
            if old_parts[-i] == new_parts[-i]:
                common_suffix_len = i
            else:
                break

        if common_suffix_len > 0:
            old_prefix = "/".join(old_parts[:-common_suffix_len])
            new_prefix = "/".join(new_parts[:-common_suffix_len])
        else:
            old_prefix = "/".join(old_parts[:-1])
            new_prefix = "/".join(new_parts[:-1])

        transforms[(old_prefix, new_prefix)].append(path)

    return {
        new_prefix: (old_prefix, files)
        for (old_prefix, new_prefix), files in transforms.items()
        if len(files) >= 3
    }


def summarize_file_operations(staged_files):
    """Analyze staged files and return high-level operation summaries."""
    operations = []
    handled_files = set()

    dir_moves = detect_directory_moves(staged_files)
    for new_prefix, (old_prefix, files) in sorted(dir_moves.items(), key=lambda x: -len(x[1])):
        files = [f for f in files if f not in handled_files]
        if len(files) < 3:
            continue

        handled_files.update(files)
        old_name = old_prefix.split("/")[-1] if old_prefix else "files"
        new_name = new_prefix.split("/")[-1] if new_prefix else "root"

        if old_prefix and new_prefix:
            if old_name == new_name:
                msg = f"refactor: move {old_prefix}/ to {new_prefix}/"
            else:
                msg = f"refactor: rename {old_prefix}/ to {new_prefix}/"
        elif new_prefix:
            msg = f"refactor: move files into {new_prefix}/"
        else:
            msg = f"refactor: move {old_prefix}/ to root"

        operations.append({
            "files": files,
            "message": msg,
            "description": f"{len(files)} files moved"
        })

    remaining = {p: info for p, info in staged_files.items() if p not in handled_files}

    by_op_and_dir = defaultdict(lambda: defaultdict(list))
    for path, info in remaining.items():
        if info.get("deleted"):
            op = "delete"
        elif info.get("old") != path:
            op = "rename"
        else:
            op = "change"

        dir_key = _dir_scope(path) or "root"
        by_op_and_dir[op][dir_key].append(path)

    op_templates = [
        ("delete",  "chore({scope}): remove {dir}/",            "chore({scope}): remove {file}",            "deleted"),
        ("change",  "chore({scope}): update {dir}/",             "chore({scope}): update {file}",            "changed"),
        ("rename",  "refactor({scope}): rename files in {dir}/", "refactor({scope}): rename {file}",         "renamed"),
    ]
    for op_key, bulk_tmpl, single_tmpl, verb in op_templates:
        for dir_key, files in by_op_and_dir[op_key].items():
            scope = dir_key if dir_key != "root" else ""
            if len(files) >= 3:
                msg = bulk_tmpl.format(scope=scope, dir=dir_key) if scope else bulk_tmpl.replace("({scope})", "").format(dir=dir_key)
                operations.append({
                    "files": files,
                    "message": msg,
                    "description": f"{len(files)} files {verb}"
                })
                handled_files.update(files)
            else:
                for f in files:
                    label = _smart_path_label(f)
                    msg = single_tmpl.format(scope=scope, file=label) if scope else single_tmpl.replace("({scope})", "").format(file=label)
                    operations.append({
                        "files": [f],
                        "message": msg,
                        "description": ""
                    })
                    handled_files.add(f)

    return operations


def group_files_by_directory(staged_files):
    """Smart grouping that detects directory-level operations."""
    operations = summarize_file_operations(staged_files)
    if operations:
        return operations
    return [{
        "files": list(staged_files.keys()),
        "message": "chore: update files",
        "description": f"{len(staged_files)} files changed"
    }]


def _smart_fallback_commits(normalized, staged_files):
    """Generate commits from smart file analysis when LLM fails."""
    group_staged = {f: staged_files[f] for f in normalized if f in staged_files}
    smart_ops = summarize_file_operations(group_staged)
    if smart_ops:
        return [{"files": op["files"], "message": op["message"], "description": op.get("description", "")} for op in smart_ops]
    if normalized:
        return [{"files": list(normalized), "message": "chore: update files", "description": ""}]
    return []


def _phase2_plan(config, n_files, hint):
    """Pick the phase 2 prompt, plus the body to use if the model writes none.

    A one-file group gets the subject-only prompt on claude. Writing the body
    is most of the cost of a call there, and phase 1 already described the
    group, so its hint becomes the body instead.
    """
    prompts = PROMPTS[config["PROVIDER"]]
    if config["PROVIDER"] == PROVIDER_CLAUDE and n_files == 1:
        return prompts["phase2_subject"], hint
    return prompts["phase2"], ""


def call_llm_two_phase(config, diff, staged_files, missing_hint=None):
    """Two-phase approach for large diffs with many files.

    ``diff`` is the already-computed unified diff; we parse it once into a
    per-file cache so phase-2 group slicing is an in-memory dict lookup
    instead of re-running ``git diff`` per group.
    """
    excludes = build_pathspec_excludes()
    name_status, _, _ = run(["git", "diff", "--cached", "--name-status", "-M", "--", "."] + excludes)
    stat, _, _ = run(["git", "diff", "--cached", "--stat", "--", "."] + excludes)
    diff_by_file = parse_diff_by_file(diff)

    path_ctx = compute_path_context(staged_files.keys())
    phase1_content = f"{path_ctx}FILE CHANGES:\n{name_status}\nSTATISTICS:\n{stat}"
    if missing_hint:
        hint_line = "IMPORTANT: You previously missed these files — include ALL of them: " + ", ".join(sorted(missing_hint))
        phase1_content = hint_line + "\n\n" + phase1_content

    if len(phase1_content) > MAX_PHASE1_CHARS:
        warn(f"file summary too large ({len(phase1_content)} chars), grouping by directory instead")
        log("INFO", "skipping LLM phase 1 due to size", {"chars": len(phase1_content)})
        groups = group_files_by_directory(staged_files)
    else:
        log("INFO", "phase 1: sending file summary to LLM", {"chars": len(phase1_content)})
        if _spinner:
            _spinner.set(f"Grouping files ({len(staged_files)})")
        try:
            groups = call_llm_raw(config, PHASE1_PROMPT, phase1_content, task_label="phase1-grouping")
        except ContextLengthExceeded:
            warn("LLM context length exceeded, falling back to directory grouping")
            groups = group_files_by_directory(staged_files)

    if isinstance(groups, dict):
        groups = groups.get("groups", groups.get("commits", []))

    if not isinstance(groups, list):
        warn(f"phase 1 returned non-list ({type(groups).__name__}), using smart grouping")
        groups = group_files_by_directory(staged_files)

    if not groups:
        groups = group_files_by_directory(staged_files)

    # Separate groups that already have messages from those needing LLM
    commits = []
    llm_tasks = []  # (index, normalized_files)

    for i, group in enumerate(groups):
        if not isinstance(group, dict):
            continue
        files = group.get("files", [])
        if not files:
            continue

        if group.get("message"):
            normalized = normalize_llm_files(files, staged_files) if isinstance(files[0], str) else files
            if normalized:
                commits.append((i, {
                    "files": normalized,
                    "message": group["message"],
                    "description": group.get("description", ""),
                }))
            continue

        normalized = normalize_llm_files(files, staged_files)
        if not normalized:
            continue

        group_diff = slice_diff_by_file(diff_by_file, normalized)
        if not group_diff.strip():
            # Fall back to shelling out if the file wasn't in the parsed
            # cache (e.g. encoding edge cases). Rare.
            group_diff = get_diff_for_files(normalized)
        if not group_diff.strip():
            continue

        content = prepare_diff_for_llm(config, group_diff, max_chars=30000)
        group_ctx = compute_path_context(normalized)
        if group_ctx:
            content = group_ctx + "\n" + content
        hint = group.get("hint") if isinstance(group.get("hint"), str) else ""
        prompt, fallback_description = _phase2_plan(config, len(normalized), hint)
        llm_tasks.append((i, normalized, content, prompt, fallback_description))

    # Run all phase 2 LLM calls in parallel
    if llm_tasks:
        total_tasks = len(llm_tasks)
        done_count = [0]
        log("INFO", "phase 2: sending groups to LLM in parallel", {"groups": total_tasks})

        def _phase2_msg():
            snap = _timings.snapshot()
            done = done_count[0]
            inflight = snap["inflight"]
            recent = snap["durations"][-10:]
            avg = sum(recent) / len(recent) if recent else 0.0
            remaining = total_tasks - done
            if avg and inflight and remaining > 0:
                eta = avg * remaining / max(inflight, 1)
                eta_str = f" · ~{eta:.0f}s left"
            else:
                eta_str = ""
            slowest = f" · slowest {max(recent):.0f}s" if recent else ""
            return (
                f"Writing commit messages {done}/{total_tasks}"
                f" · {inflight} in flight{eta_str}{slowest}"
            )

        if _spinner:
            _spinner.set_dynamic(_phase2_msg)

        def _phase2_call(task):
            idx, normalized, content, prompt, fallback_description = task
            log("INFO", "phase 2: sending diff to LLM", {"group": idx + 1, "chars": len(content), "files": len(normalized)})
            try:
                result = call_llm_raw(
                    config, prompt, content, task_label=f"group {idx + 1}"
                )
            except ContextLengthExceeded:
                return (idx, "context_exceeded", normalized, fallback_description)
            return (idx, result, normalized, fallback_description)

        max_parallel = PHASE2_MAX_PARALLEL[config["PROVIDER"]]
        with ThreadPoolExecutor(max_workers=min(total_tasks, max_parallel)) as executor:
            futures = {executor.submit(_phase2_call, t): t for t in llm_tasks}
            for future in as_completed(futures):
                done_count[0] += 1
                idx, result, normalized, fallback_description = future.result()

                if result == "context_exceeded":
                    warn(f"context length exceeded for group {idx + 1}, using smart analysis")
                    commits.extend((idx, c) for c in _smart_fallback_commits(normalized, staged_files))
                    continue

                if isinstance(result, list) and len(result) > 0:
                    result = result[0]
                if not isinstance(result, dict):
                    warn(f"phase 2 returned non-dict for group {idx + 1}, using smart analysis")
                    commits.extend((idx, c) for c in _smart_fallback_commits(normalized, staged_files))
                    continue

                message = result.get("message")
                if not message or message.lower() in ("message", ""):
                    warn(f"phase 2 missing message for group {idx + 1}, using smart analysis")
                    fallback = _smart_fallback_commits(normalized, staged_files)
                    if fallback:
                        commits.extend((idx, c) for c in fallback)
                        continue
                    message = f"chore: update {len(normalized)} files"

                description = result.get("description", "")
                if description.lower() == "description":
                    description = ""
                if not description:
                    description = fallback_description

                commits.append((idx, _ensure_grounded_scope({"files": normalized, "message": _clean_commit_message(message), "description": description})))

    # Sort by original group index to preserve logical ordering
    commits.sort(key=lambda x: x[0])
    return [c for _, c in commits]


def get_lockfiles_in_staging():
    """Get list of lockfiles that are staged in the current directory and below."""
    staged, _, _ = run(["git", "diff", "--cached", "--name-only", "--", "."])
    return [git_unquote(f) for f in staged.strip().splitlines() if f and is_lockfile(git_unquote(f))]


