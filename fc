def _fmt_files(files, limit=4):
    """Format a file list compactly for display."""
    shown = sorted(files)[:limit]
    result = ", ".join(_dim(f) for f in shown)
    if len(files) > limit:
        result += _dim(f" +{len(files) - limit} more")
    return result


def _print_commit_plan(commits, lockfiles):
    """Print a numbered plan of all commits about to be made."""
    all_entries = list(commits)
    if lockfiles:
        all_entries.append({
            "message": "chore: update lockfiles",
            "description": "",
            "files": lockfiles,
        })

    sprint("")
    sprint(_dim("  Planned commits:"))
    sprint(_dim("  " + "─" * 58))
    for i, c in enumerate(all_entries, 1):
        msg = c["message"]
        desc = c.get("description", "")
        files = c.get("files", [])
        sprint(f"  {_dim(f'{i:2d}')}  {msg}")
        if desc:
            sprint(f"       {_dim(desc)}")
        sprint(f"       {_fmt_files(files)}")
    sprint(_dim("  " + "─" * 58))
    sprint("")


