# Directories that are monorepo containers — scope should be the child (project name)
CONTAINER_DIRS = {"apps", "packages", "libs", "services", "crates", "cmd", "tools"}


def _dir_scope(path):
    """Extract monorepo-aware scope from a file path.

    In monorepos where the first directory is a container (apps/, packages/, etc.),
    the scope is the project name (2nd component). Otherwise it's the first directory.
    """
    parts = path.split("/")
    if len(parts) > 2 and parts[0] in CONTAINER_DIRS:
        return parts[1]
    if len(parts) > 1:
        return parts[0]
    return ""


def _smart_path_label(path):
    """Return a grounded label for a file path, suitable for commit messages.

    Instead of just the leaf filename, includes enough path context to be meaningful.
    """
    parts = path.split("/")
    if len(parts) <= 2:
        return path
    if parts[0] in CONTAINER_DIRS and len(parts) > 2:
        return f"{parts[1]}/{parts[-1]}"
    return f"{parts[0]}/{parts[-1]}"


def compute_path_context(file_paths):
    """Compute a path context hint for the LLM from staged file paths.

    Returns a string like:
      PATH CONTEXT: All files under "apps/grupeta/". Projects: grupeta.
    or for multi-project changes:
      PATH CONTEXT: Projects: grupeta, shared. Dirs: apps/grupeta/, packages/shared/.
    """
    if not file_paths:
        return ""
    paths = list(file_paths)
    scopes = defaultdict(set)
    for p in paths:
        parts = p.split("/")
        if len(parts) > 2 and parts[0] in CONTAINER_DIRS:
            scopes[parts[1]].add("/".join(parts[:2]))
        elif len(parts) > 1:
            scopes[parts[0]].add(parts[0])

    if not scopes:
        return ""

    projects = sorted(scopes.keys())
    if len(projects) == 1:
        proj = projects[0]
        dirs = sorted(scopes[proj])
        return f"PATH CONTEXT: All files under \"{dirs[0]}/\". Project: {proj}.\n"

    all_dirs = sorted(d for ds in scopes.values() for d in ds)
    return f"PATH CONTEXT: Projects: {', '.join(projects)}. Dirs: {', '.join(d + '/' for d in all_dirs)}.\n"


