_USE_COLOR = sys.stdout.isatty() and sys.stderr.isatty() and "NO_COLOR" not in os.environ


def _c(code, text):
    """Apply ANSI color if supported."""
    if not _USE_COLOR:
        return text
    return f"\033[{code}m{text}\033[0m"


def _green(t): return _c("32", t)
def _red(t): return _c("31", t)
def _yellow(t): return _c("33", t)
def _dim(t): return _c("2", t)
def _cyan(t): return _c("36", t)


TICK = _green("✓")
CROSS = _red("✗")
WARN_SYM = _yellow("⚠")
SPINNER_FRAMES = ["⠋", "⠙", "⠹", "⠸", "⠼", "⠴", "⠦", "⠧", "⠇", "⠏"]

_output_lock = threading.Lock()


class Timings:
    """Track wall-clock time per phase and aggregate LLM request stats.

    Used both for live progress (in-flight count, ETA) and for the end-of-run
    breakdown so the user can see exactly where time went.
    """

    def __init__(self):
        self._lock = threading.Lock()
        self._phases = {}         # name -> accumulated wall seconds
        self._phase_start = {}    # name -> monotonic start
        self._llm_total = 0.0     # sum of individual LLM durations (for parallel efficiency)
        self._llm_count = 0
        self._llm_inflight = 0
        self._llm_durations = []  # rolling history for ETA
        self._start = time.monotonic()

    def phase_start(self, name):
        with self._lock:
            self._phase_start[name] = time.monotonic()

    def phase_end(self, name):
        with self._lock:
            if name in self._phase_start:
                self._phases[name] = self._phases.get(name, 0.0) + (
                    time.monotonic() - self._phase_start.pop(name)
                )

    def request_started(self):
        with self._lock:
            self._llm_inflight += 1

    def request_finished(self, duration):
        with self._lock:
            self._llm_inflight = max(0, self._llm_inflight - 1)
            self._llm_total += duration
            self._llm_count += 1
            self._llm_durations.append(duration)

    def snapshot(self):
        with self._lock:
            return {
                "inflight": self._llm_inflight,
                "llm_total": self._llm_total,
                "llm_count": self._llm_count,
                "durations": list(self._llm_durations),
                "elapsed": time.monotonic() - self._start,
            }

    def summary_line(self):
        with self._lock:
            # Deterministic ordering: phases in the order we started them.
            parts = [f"{name} {t:.1f}s" for name, t in self._phases.items()]
            total = time.monotonic() - self._start
            parts.append(f"total {total:.1f}s")
            if self._llm_count:
                parts.append(
                    f"llm {self._llm_total:.1f}s/{self._llm_count} req"
                )
            return " · ".join(parts)


_timings = Timings()


class Spinner:
    """Thread-based terminal spinner. All output must go through this object
    so that the spinner line is cleared before any print.

    Supports a dynamic message callback so phase 2 can show live progress
    (n/N, in-flight count, ETA) without polling from the main thread.
    """

    def __init__(self):
        self._msg = ""
        self._dynamic = None
        self._phase_start = time.monotonic()
        self._last_line_len = 0
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._run, daemon=True)
        self._thread.start()

    def _render_text(self):
        if self._dynamic is not None:
            try:
                return self._dynamic()
            except Exception:
                return self._msg
        return self._msg

    def _run(self):
        i = 0
        while not self._stop.wait(0.1):
            with _output_lock:
                frame = _cyan(SPINNER_FRAMES[i % len(SPINNER_FRAMES)])
                elapsed = time.monotonic() - self._phase_start
                body = self._render_text()
                suffix = _dim(f" {elapsed:.1f}s")
                line = f"{frame} {body}{suffix}"
                # Pad over whatever we printed last frame so trailing
                # characters from longer messages don't linger.
                pad = max(0, self._last_line_len - len(line))
                sys.stdout.write("\r" + line + (" " * pad))
                sys.stdout.flush()
                self._last_line_len = len(line)
            i += 1

    def set(self, message):
        """Update the spinner message and restart the per-phase elapsed timer."""
        self._msg = message
        self._dynamic = None
        self._phase_start = time.monotonic()

    def set_dynamic(self, fn):
        """Provide a callable whose return value is rendered every frame."""
        self._dynamic = fn
        self._phase_start = time.monotonic()

    def _clear(self):
        """Clear spinner line. Must be called with _output_lock held."""
        if self._last_line_len:
            sys.stdout.write("\r" + " " * self._last_line_len + "\r")
            sys.stdout.flush()
            self._last_line_len = 0

    def println(self, message, file=None):
        """Print a line, temporarily pausing the spinner."""
        with _output_lock:
            self._clear()
            print(message, file=file or sys.stdout)

    def ok(self, message):
        self.println(f"{TICK} {message}")

    def fail(self, message):
        self.println(f"{CROSS} {message}", file=sys.stderr)

    def warn(self, message):
        self.println(f"{WARN_SYM} {message}", file=sys.stderr)

    def stop(self):
        if self._stop.is_set():
            return
        self._stop.set()
        self._thread.join()
        with _output_lock:
            self._clear()


_spinner: "Spinner | None" = None


def sprint(message, file=None):
    """Print a message, clearing the spinner line first if one is active."""
    if _spinner:
        _spinner.println(message, file=file)
    else:
        print(message, file=file or sys.stdout)


# ---------------------------------------------------------------------------
# Error / warning helpers
# ---------------------------------------------------------------------------

def warn(message, context=None):
    """Print warning to user and log it."""
    if _spinner:
        _spinner.warn(message)
    else:
        print(f"{WARN_SYM} {message}", file=sys.stderr)
    log("WARN", message, context)


def record_error(message, context=None):
    """Record error details to session log with full context."""
    log("ERROR", message, context)
    exc_info = traceback.format_exc()
    if exc_info and exc_info.strip() != "NoneType: None":
        log_file = get_session_log()
        with open(log_file, "a") as f:
            f.write(f"Stack trace:\n{exc_info}\n")
    log_git_state()
    sprint(f"  session log: {get_session_log()}", file=sys.stderr)


_audit_repo = None


_audit_dir_created = False


def audit(event, data=None):
    """Append a structured entry to the persistent audit log."""
    global _audit_repo, _audit_dir_created
    if not _audit_dir_created:
        AUDIT_LOG.parent.mkdir(parents=True, exist_ok=True)
        _audit_dir_created = True
    if _audit_repo is None:
        repo_result = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, timeout=5,
        )
        _audit_repo = repo_result.stdout.decode().strip() if repo_result.returncode == 0 else "unknown"
    entry = {
        "ts": datetime.now().isoformat(),
        "repo": _audit_repo,
        "event": event,
    }
    if data:
        entry["data"] = data
    with open(AUDIT_LOG, "a") as f:
        f.write(json.dumps(entry) + "\n")


def exit_with_error(message, context=None):
    """Print error, record to disk, and exit."""
    if _spinner:
        _spinner.fail(f"error: {message}")
        _spinner.stop()
    else:
        print(f"error: {message}", file=sys.stderr)
    record_error(message, context)
    audit("error", {"message": message})
    sys.exit(1)


